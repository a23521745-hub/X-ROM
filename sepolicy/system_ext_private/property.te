#
# system_ext_private/property.te — X-ROM property types.
#

# ro.xrom.avf.*   build-time facts (avf.mk -> PRODUCT_SYSTEM_EXT_PROPERTIES)
# xrom.avf.*      runtime state written by xrom_avfd
# persist.xrom.avf.*  operator overrides that survive a reboot
#
# Declared as a plain property_type rather than through system_internal_prop():
# the macro lives in system/sepolicy/private/property.te and its exact behaviour
# has changed across releases, and X-ROM's policy has to compile unchanged from
# Android 13 to current.
type xrom_avf_prop, property_type;

# sys.xrom.recovery.*   runtime state written by xrom_sentineld: the quarantine
#                       marker that the recovery image and the next boot read.
# xrom.recovery.*       non-persistent state.
#
# A plain property_type rather than system_internal_prop(), for the same reason as
# xrom_avf_prop: the macro lives in system/sepolicy/private/property.te and its exact
# behaviour has changed across releases, and this policy has to compile unchanged from
# Android 13 to current.
type xrom_recovery_prop, property_type;
