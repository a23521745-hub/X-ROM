# android.xrom.isolation.IXIsolationService/xrom_isolation
#
# Not marked app_api_service or system_api_service: X-ROM does not want third
# party apps, or even ordinary platform apps, resolving this name. Reachability
# is granted per-domain through xrom_avfd_client() in xrom_avfd.te, and the
# private policy carries a neverallow that makes "everything else" explicit.
type xrom_avf_service, service_manager_type;
